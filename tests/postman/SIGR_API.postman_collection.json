        {
          "name": "API-12 Administrador consulta ventas diarias",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type es JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "pm.test(\"Responde en menos de 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "const v = pm.response.json();",
                  "pm.test(\"Cada día cumple el esquema\", () => v.forEach(d => {",
                  "  pm.expect(d).to.have.all.keys(\"fecha\", \"numPedidos\", \"totalVentas\");",
                  "  pm.expect(d.numPedidos).to.be.at.least(0); pm.expect(d.totalVentas).to.be.at.least(0);",
                  "}));",
                  "pm.test(\"Ordenado de la fecha más reciente a la más antigua\", () => {",
                  "  for (let i = 1; i < v.length; i++) pm.expect(new Date(v[i-1].fecha) >= new Date(v[i].fecha)).to.be.true;",
                  "});"
                ]
              }
            }
