  "item": [
    {
      "name": "1. Menú público",
      "item": [
        {
          "name": "API-01 Listar platos disponibles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type es JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "pm.test(\"Responde en menos de 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "const platos = pm.response.json();",
                  "pm.test(\"Devuelve una lista con platos\", () => { pm.expect(platos).to.be.an(\"array\").that.is.not.empty; });",
                  "pm.test(\"Cada plato cumple el esquema\", () => platos.forEach(p => {",
                  "  pm.expect(p).to.have.all.keys(\"platoId\", \"nombre\", \"descripcion\", \"categoria\", \"precio\");",
                  "  pm.expect(p.platoId).to.be.a(\"number\"); pm.expect(p.nombre).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(p.precio).to.be.above(0);",
                  "}));",
                  "pm.collectionVariables.set(\"platoId\", platos[0].platoId);",
                  "pm.collectionVariables.set(\"platoNombre\", platos[0].nombre);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/platos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "platos"
              ]
            },
            "description": "Caso de prueba API-01. Ruta pública, no requiere sesión."
          }
        },
        {
          "name": "API-02 Filtrar platos por categoría",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
                  "const platos = pm.response.json();",
                  "pm.test(\"Hay platos en la categoría\", () => pm.expect(platos).to.not.be.empty);",
                  "pm.test(\"Todos pertenecen a Bebidas\", () => platos.forEach(p => pm.expect(p.categoria).to.eql(\"Bebidas\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/platos?categoria=Bebidas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "platos"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "Bebidas"
                }
              ]
            },
            "description": ""
          }
        },
