              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test(\"Es el plato solicitado (variable de API-01)\", () => {",
                  "  pm.expect(p.platoId).to.eql(Number(pm.collectionVariables.get(\"platoId\")));",
                  "  pm.expect(p.nombre).to.eql(pm.collectionVariables.get(\"platoNombre\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
