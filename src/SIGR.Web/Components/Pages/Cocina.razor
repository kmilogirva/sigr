@page "/cocina"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Cocinero,Administrador")]
@implements IDisposable
@inject PedidoService PedidoSvc

<PageTitle>Cocina</PageTitle>
<div class="d-flex flex-wrap justify-content-between align-items-end mb-3 gap-2">
    <div>
        <h1 class="h2 fw-bold mb-0">Cocina</h1>
        <p class="text-muted small mb-0">Se actualiza automáticamente cada 5 segundos.</p>
    </div>
    @if (promedio is not null)
    {
        <span class="badge bg-light text-dark border fs-6"><i class="bi bi-stopwatch me-1"></i>Preparación promedio hoy: @promedio.Value.ToString("0.#") min</span>
    }
</div>

@if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger">@error</div> }

<div class="row g-3">
    @foreach (var (estado, titulo, color) in Columnas)
    {
        var e = estado;
        var items = comandas.Where(c => c.Pedido.Estado == e).ToList();
        <div class="col-lg-4">
            <div class="d-flex align-items-center mb-2">
                <h2 class="h5 fw-bold mb-0">@titulo</h2><span class="badge @color ms-2">@items.Count</span>
            </div>
            @foreach (var c in items)
            {
                var minutos = (int)(DateTime.Now - (e == "EnPreparacion" ? c.Pedido.InicioPreparacion ?? c.Pedido.FechaHora : c.Pedido.FechaHora)).TotalMinutes;
                var alerta = e != "Listo" && minutos >= 20 ? "border-danger" : e != "Listo" && minutos >= 10 ? "border-warning" : "border-0";
                <div class="card shadow-sm mb-3 border-2 @alerta comanda">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <strong>Pedido #@c.Pedido.PedidoId · Mesa @c.Pedido.NumeroMesa</strong>
                            <span class="small @(alerta == "border-danger" ? "text-danger fw-bold" : "text-muted")"><i class="bi bi-clock"></i> @(Math.Max(minutos, 0)) min</span>
                        </div>
                        <ul class="list-unstyled my-2 mb-3">
                            @foreach (var it in c.Items)
                            {
                                <li><span class="fw-bold">@it.Cantidad ×</span> @it.Plato
                                    @if (!string.IsNullOrEmpty(it.Nota)) { <div class="small text-danger"><i class="bi bi-chat-left-text"></i> @it.Nota</div> }</li>
                            }
                            @if (!c.Items.Any()) { <li class="text-muted small">Sin ítems.</li> }
                        </ul>
                        @if (e == "Pendiente") { <button class="btn btn-warning btn-sm w-100" @onclick="() => Avanzar(c.Pedido.PedidoId, e)" disabled="@(!c.Items.Any())"><i class="bi bi-play-fill"></i> Iniciar preparación</button> }
                        else if (e == "EnPreparacion") { <button class="btn btn-success btn-sm w-100" @onclick="() => Avanzar(c.Pedido.PedidoId, e)"><i class="bi bi-check2-circle"></i> Marcar listo</button> }
                        else { <div class="text-success small"><i class="bi bi-bell"></i> Listo para que el mesero lo entregue</div> }
                    </div>
                </div>
            }
            @if (!items.Any()) { <div class="text-muted text-center small py-4 border rounded bg-white">Sin comandas</div> }
        </div>
    }
</div>

@code {
    static readonly (string Estado, string Titulo, string Color)[] Columnas =
    {
        ("Pendiente", "Nuevas", "bg-secondary"), ("EnPreparacion", "En preparación", "bg-warning text-dark"), ("Listo", "Listas", "bg-success")
    };

    List<ComandaCocina> comandas = new();
    double? promedio;
    string? error;
    Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
        timer = new Timer(_ => InvokeAsync(async () => { await Cargar(); StateHasChanged(); }), null, 5000, 5000);
    }

    async Task Cargar() { comandas = await PedidoSvc.ComandasAsync(); promedio = await PedidoSvc.PromedioPreparacionHoyAsync(); }

    async Task Avanzar(int id, string desde)
    {
        error = null;
        try { await PedidoSvc.CocinaAvanzarAsync(id, desde); }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException) { error = ex.Message; }
        await Cargar();
    }

    public void Dispose() => timer?.Dispose();
}
