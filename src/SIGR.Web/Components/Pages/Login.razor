@page "/login"
@layout Layout.AuthLayout

<PageTitle>Iniciar sesión</PageTitle>
<div>
    <h1 class="h3 fw-bold mb-3">Iniciar sesión</h1>
    @if (Error == "1") { <div class="alert alert-danger">Correo o contraseña incorrectos.</div> }
    @if (Registrado == "1") { <div class="alert alert-success">Registro exitoso. Ya puedes iniciar sesión.</div> }
    <form method="post" action="/account/login">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <div class="mb-3"><label class="form-label">Correo</label>
            <input name="email" type="email" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">Contraseña</label>
            <input name="password" type="password" class="form-control" required /></div>
        <button class="btn btn-primary w-100">Entrar</button>
    </form>
    <p class="mt-3">¿Cliente nuevo? <a href="registro">Regístrate</a></p>
    <p class="text-muted small">Demo: admin@sigr.test · carlos.mesero@sigr.test · maria.lopez@correo.test — clave <code>Sigr2026!</code></p>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Registrado { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
}
