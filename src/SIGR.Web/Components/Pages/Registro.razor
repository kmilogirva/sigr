@page "/registro"
@layout Layout.AuthLayout

<PageTitle>Registro de cliente</PageTitle>
<div>
    <h1 class="h3 fw-bold mb-3">Registro de cliente</h1>
    @if (!string.IsNullOrEmpty(Error)) { <div class="alert alert-danger">@Error</div> }
    <form method="post" action="/account/register">
        <AntiforgeryToken />
        <div class="mb-3"><label class="form-label">Nombre completo</label>
            <input name="nombre" class="form-control" required maxlength="100" /></div>
        <div class="mb-3"><label class="form-label">Correo</label>
            <input name="email" type="email" class="form-control" required maxlength="120" /></div>
        <div class="mb-3"><label class="form-label">Teléfono</label>
            <input name="telefono" class="form-control" maxlength="20" /></div>
        <div class="mb-3"><label class="form-label">Contraseña (mín. 6)</label>
            <input name="password" type="password" class="form-control" required minlength="6" /></div>
        <button class="btn btn-success w-100">Crear cuenta</button>
    </form>
    <p class="mt-3"><a href="login">Volver a iniciar sesión</a></p>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
