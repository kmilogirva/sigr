@page "/admin/cupones"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]
@inject PagoService PagoSvc

<PageTitle>Cupones</PageTitle>
<div class="mb-3">
    <h1 class="h2 fw-bold mb-0">Cupones de descuento</h1>
    <p class="text-muted mb-0">Los meseros los aplican al cobrar un pedido.</p>
</div>

@if (!string.IsNullOrEmpty(mensaje)) { <div class="alert @(esError ? "alert-danger" : "alert-success")">@mensaje</div> }

<div class="row g-4">
    <div class="col-lg-8">
        <table class="table table-sm align-middle">
            <thead><tr><th>Código</th><th>Descuento</th><th>Vigencia</th><th class="text-end">Usos</th><th>Estado</th><th></th></tr></thead>
            @foreach (var c in cupones)
            {
                var motivo = PagoService.MotivoInvalido(c, DateTime.Today);
                <tr>
                    <td><code>@c.Codigo</code></td>
                    <td>@(c.Tipo == "Porcentaje" ? c.Valor.ToString("0.##") + " %" : c.Valor.ToString("C0"))</td>
                    <td class="small">@c.VigenteDesde.ToString("dd/MM/yy") – @c.VigenteHasta.ToString("dd/MM/yy")</td>
                    <td class="text-end">@c.UsosActuales@(c.UsosMaximos is null ? "" : " / " + c.UsosMaximos)</td>
                    <td><span class="badge @(motivo is null ? "bg-success" : "bg-secondary")">@(motivo is null ? "Vigente" : motivo.Replace("El cupón ", "").TrimEnd('.'))</span></td>
                    <td class="text-end"><button class="btn btn-outline-secondary btn-sm" @onclick="() => nuevo = Clonar(c)">Editar</button></td>
                </tr>
            }
        </table>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h2 class="h6 fw-bold">@(nuevo.CuponId == 0 ? "Nuevo cupón" : "Editar cupón")</h2>
            <input class="form-control form-control-sm mb-2" maxlength="20" placeholder="CÓDIGO (letras y números)" @bind="nuevo.Codigo" />
            <div class="row g-2 mb-2">
                <div class="col-6"><select class="form-select form-select-sm" @bind="nuevo.Tipo"><option>Porcentaje</option><option>Monto</option></select></div>
                <div class="col-6"><input type="number" step="0.01" class="form-control form-control-sm" placeholder="@(nuevo.Tipo == "Porcentaje" ? "% de descuento" : "Valor en $")" @bind="nuevo.Valor" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-6"><label class="form-label small mb-0">Desde</label><input type="date" class="form-control form-control-sm" @bind="nuevo.VigenteDesde" /></div>
                <div class="col-6"><label class="form-label small mb-0">Hasta</label><input type="date" class="form-control form-control-sm" @bind="nuevo.VigenteHasta" /></div>
            </div>
            <input type="number" min="1" class="form-control form-control-sm mb-2" placeholder="Máximo de usos (vacío = ilimitado)" @bind="nuevo.UsosMaximos" />
            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="cupActivo" @bind="nuevo.Activo" /><label class="form-check-label" for="cupActivo">Activo</label></div>
            <button class="btn btn-primary btn-sm" @onclick="Guardar">@(nuevo.CuponId == 0 ? "Crear" : "Actualizar")</button>
            @if (nuevo.CuponId != 0) { <button class="btn btn-link btn-sm" @onclick="() => nuevo = new()">Cancelar</button> }
        </div></div>
    </div>
</div>

@code {
    List<Cupon> cupones = new();
    Cupon nuevo = new();
    string? mensaje;
    bool esError;

    protected override async Task OnInitializedAsync() => cupones = await PagoSvc.CuponesAsync();

    async Task Guardar()
    {
        mensaje = null;
        try { await PagoSvc.GuardarCuponAsync(nuevo); mensaje = "Cupón guardado."; esError = false; nuevo = new(); }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException) { mensaje = ex.Message; esError = true; }
        cupones = await PagoSvc.CuponesAsync();
    }

    static Cupon Clonar(Cupon c) => new()
    {
        CuponId = c.CuponId, Codigo = c.Codigo, Tipo = c.Tipo, Valor = c.Valor, VigenteDesde = c.VigenteDesde,
        VigenteHasta = c.VigenteHasta, UsosMaximos = c.UsosMaximos, UsosActuales = c.UsosActuales, Activo = c.Activo
    };
}
