@page "/"
<PageTitle>SIGR</PageTitle>
<h1>Sistema Integral de Gestión de Restaurante</h1>
<AuthorizeView>
    <Authorized><p class="lead">Bienvenido, <strong>@context.User.Identity?.Name</strong> (@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value).</p></Authorized>
    <NotAuthorized><p class="lead">Gestiona menú, pedidos, reservas y caja. <a href="login">Inicia sesión</a> para continuar.</p></NotAuthorized>
</AuthorizeView>
