<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SIGR</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Inicio</NavLink>
        </div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="menu">Menú</NavLink></div>
        <AuthorizeView>
            <div class="nav-item px-3"><NavLink class="nav-link" href="reservas">Reservas</NavLink></div>
        </AuthorizeView>
        <AuthorizeView Roles="Mesero,Administrador">
            <div class="nav-item px-3"><NavLink class="nav-link" href="pedidos">Pedidos</NavLink></div>
        </AuthorizeView>
        <AuthorizeView Roles="Administrador">
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/menu">Administrar menú</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="caja">Caja</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="reportes">Reportes</NavLink></div>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <form method="post" action="/account/logout">
                        <AntiforgeryToken />
                        <button class="nav-link btn btn-link text-start w-100">Cerrar sesión</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3"><NavLink class="nav-link" href="login">Iniciar sesión</NavLink></div>
                <div class="nav-item px-3"><NavLink class="nav-link" href="registro">Registro</NavLink></div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
