@inherits LayoutComponentBase

<div class="auth-page">
    <div class="auth-side d-none d-lg-flex">
        <div>
            <div class="auth-brand"><i class="bi bi-cup-hot-fill me-2"></i>SIGR</div>
            <h2 class="display-6 fw-bold mt-4">Sabor que se reserva</h2>
            <p class="lead opacity-75">Consulta el menú, reserva tu mesa y haz tu pedido desde un solo lugar.</p>
        </div>
    </div>
    <div class="auth-main">
        <div class="auth-card">
            <a href="" class="auth-logo d-lg-none"><i class="bi bi-cup-hot-fill me-2"></i>SIGR</a>
            @Body
            <p class="text-center mt-4 mb-0"><a href="" class="small text-muted"><i class="bi bi-arrow-left"></i> Volver al inicio</a></p>
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
