@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="me-auto fw-semibold text-secondary"><i class="bi bi-shop me-2"></i>Panel del restaurante</span>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank"><i class="bi bi-question-circle me-1"></i>Ayuda</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
